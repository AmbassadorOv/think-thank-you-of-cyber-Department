#!/usr/bin/env bash
#
# Print the largest files in a Git repository. The script must be called
# from the root of the Git repository. You can pass a threshold to print
# only files greater than a certain size (compressed size in Git database,
# default is 500kb).
#
# Files that have a large compressed size should usually be stored in
# Git LFS [2].
#
# Based on script from Antony Stubbs [1] and improved with ideas from Peff.
#
# [1] http://stubbisms.wordpress.com/2009/07/10/git-script-to-show-largest-pack-objects-and-trim-your-waist-line/
# [2] https://git-lfs.github.com/
#
# Usage:
# git-find-large-files [size threshold in KB]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    MIN_SIZE_IN_KB=500
else
    MIN_SIZE_IN_KB=$1
fi

# Use awk to join object metadata and status in a single pass.
# This is significantly faster than the original shell loop (O(N) vs O(N*logN)).
# It also fixes the dependency on the "column" command by using printf formatting.

git cat-file --batch-all-objects --batch-check='%(objectsize:disk) %(objectname)' | \
sort -nr | \
awk -v threshold="$MIN_SIZE_IN_KB" \
    -v head_objs_cmd="git rev-list --all --objects --max-count=1" \
    -v all_objs_cmd="git rev-list --all --objects" \
    -v on_disk_cmd="find . -not -path './.git/*'" \
'
BEGIN {
    # 1. Load objects in the latest commit reachable from any ref
    while ((head_objs_cmd | getline line) > 0) {
        split(line, parts, " ")
        is_head[parts[1]] = 1
    }
    close(head_objs_cmd)

    # 2. Load all objects and their paths from the entire history
    while ((all_objs_cmd | getline line) > 0) {
        n = split(line, parts, " ")
        if (n > 1) {
            sha = parts[1]
            match(line, / /)
            path[sha] = substr(line, RSTART + 1)
        }
    }
    close(all_objs_cmd)

    # 3. Load all current files/directories on disk to check "Changed" status
    while ((on_disk_cmd | getline line) > 0) {
        sub(/^\.\//, "", line)
        if (line != "" && line != ".") on_disk[line] = 1
    }
    close(on_disk_cmd)

    printf "%-10s %-10s %s\n", "SIZE(KB)", "HEAD", "LOCATION"
}
{
    size_kb = int($1 / 1024)
    if (size_kb <= threshold) exit

    sha = $2
    loc = path[sha]
    if (sha in is_head) {
        status = "Present"
    } else if (loc != "" && loc in on_disk) {
        status = "Changed"
    } else {
        status = "Deleted"
    }
    printf "%-10d %-10s %s\n", size_kb, status, loc
}
'
