#!/usr/bin/env bash
#
# Print the largest files in a Git repository. The script must be called
# from the root of the Git repository. You can pass a threshold to print
# only files greater than a certain size (compressed size in Git database,
# default is 500kb).
#
# Files that have a large compressed size should usually be stored in
# Git LFS [2].
#
# Based on script from Antony Stubbs [1] and improved with ideas from Peff.
#
# [1] http://stubbisms.wordpress.com/2009/07/10/git-script-to-show-largest-pack-objects-and-trim-your-waist-line/
# [2] https://git-lfs.github.com/
#
# Usage:
# git-find-large-files [size threshold in KB]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    MIN_SIZE_IN_KB=500
else
    MIN_SIZE_IN_KB=$1
fi

TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/git-find-large-files.XXXXXX") || exit
trap "rm -rf '$TMP_DIR'" EXIT

# Gather all necessary data
git cat-file --batch-all-objects --batch-check='%(objectsize:disk) %(objectname)' > "$TMP_DIR/sizes"
git rev-list --all --objects > "$TMP_DIR/names"
git rev-list --all --objects --max-count=1 | awk '{print $1}' > "$TMP_DIR/head_shas"
# List all files and directories on disk, excluding the .git directory
find . -name .git -prune -o -print | sed 's|^\./||' > "$TMP_DIR/on_disk"

# Process with awk (using hash map lookup for O(N) performance)
awk -v min="$MIN_SIZE_IN_KB" '
    FNR == 1 { file_idx++ }
    file_idx == 1 { head[$1]=1; next }
    file_idx == 2 { disk[$0]=1; next }
    file_idx == 3 {
        sha=$1
        if (NF > 1) {
            $1=""
            sub(/^ /, "", $0)
            name[sha]=$0
        } else {
            name[sha]=sha
        }
        next
    }
    {
        size_kb = int($1/1024)
        if (size_kb > min) {
            sha = $2
            loc = name[sha]
            if (loc == "") loc = sha
            if (sha in head) status="Present"
            else if (loc != "" && disk[loc]) status="Changed"
            else status="Deleted"
            printf "%d,%s,%s\n", size_kb, status, loc
        }
    }
' "$TMP_DIR/head_shas" "$TMP_DIR/on_disk" "$TMP_DIR/names" "$TMP_DIR/sizes" | sort -rn > "$TMP_DIR/output"

# Aligned output using awk (replaces missing column utility and improves portability)
if [ -s "$TMP_DIR/output" ]; then
    awk -F, '{ printf "%-10s %-10s %s\n", $1, $2, $3 }' "$TMP_DIR/output"
fi

rm -rf "$TMP_DIR"
exit 0
