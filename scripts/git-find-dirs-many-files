#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT=100
else
    FILE_COUNT=$1
fi

# We use awk to aggregate file counts per directory.
# This is much faster than running 'find' for every directory individually (O(N) vs O(N*Depth)).
# 1. 'find . -type f' lists all files.
# 2. 'awk' splits each path and increments counts for all parent directories.
# 3. We filter out subdirectories of .git (except .git itself) to match original behavior.
# 4. We filter by threshold and sort.

find . -type f | awk -F/ -v threshold="$FILE_COUNT" '
{
    path = ""
    for (i=1; i<NF; i++) {
        path = (i==1) ? $1 : path "/" $i
        count[path]++
    }
}
END {
    for (path in count) {
        # Exclude subdirectories of .git but keep .git itself, matching original behavior
        if (path ~ /^\.\/\.git\/.+/) continue;
        if (count[path] > threshold) {
            print count[path] " " path
        }
    }
}' | sort -nr
