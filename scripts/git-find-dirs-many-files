#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT=100
else
    FILE_COUNT=$1
fi

# Use find and awk to count files in each directory in a single pass O(N)
# instead of O(N*Depth) with nested find calls.
#
# Performance impact: For a repository with many files and deep directory
# structures, this reduces the number of file system traversals from
# one per directory to exactly one for the entire repository.
find . -type f -not -path "./.git/*" | awk '
{
    path = $0
    # Increment count for each parent directory
    while (sub(/\/[^\/]+$/, "", path)) {
        count[path]++
    }
}
END {
    for (d in count) {
        print count[d], d
    }
}' | sort -nr | while read -r line; do
    # Extract count from the beginning of the line
    count=${line%% *}
    if [ "$count" -le "$FILE_COUNT" ]; then
        break
    fi
    echo "$line"
done
