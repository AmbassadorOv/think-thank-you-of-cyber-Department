#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT=100
else
    FILE_COUNT=$1
fi

# Use awk to aggregate file counts per directory in a single pass.
# This is much faster than spawning a new find/wc process for every directory.
# We exclude .git/* to avoid counting internal Git objects.
find . -type f -not -path "./.git/*" | awk -F/ -v threshold="$FILE_COUNT" '
    {
        path = $1
        counts[path]++
        for (i = 2; i < NF; i++) {
            path = path "/" $i
            counts[path]++
        }
    }
    END {
        for (p in counts) {
            if (counts[p] > threshold) {
                print counts[p], p
            }
        }
    }' | sort -nr
