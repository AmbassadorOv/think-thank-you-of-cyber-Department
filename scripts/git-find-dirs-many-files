#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT=100
else
    FILE_COUNT=$1
fi

# Use a single pass with find and awk to count files per directory.
# This is O(N) where N is the number of files, compared to the previous
# O(N*Depth) approach which ran find for every directory.
# We also exclude the .git directory completely as it's not a 3rd party
# component candidate.
find . -type f -not -path "./.git/*" | awk -F/ -v threshold="$FILE_COUNT" '
{
    path = $1
    for (i = 2; i < NF; i++) {
        path = path "/" $i
        count[path]++
    }
    count["."]++
}
END {
    for (p in count) {
        if (count[p] > threshold) {
            print count[p], p
        }
    }
}' | sort -nr
