#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT_THRESHOLD=100
else
    FILE_COUNT_THRESHOLD=$1
fi

# Performance Optimization:
# Replace the original O(N*Depth) nested find calls with a single-pass O(N) pipeline.
# We use 'find' to list all files once, and 'awk' to aggregate counts for all
# parent directories. This is significantly faster on large repositories.
find . -path "./.git" -prune -o -type f -print | awk -F/ '{
    path = ""
    for (i=1; i<NF; i++) {
        path = (i==1) ? $i : path "/" $i
        count[path]++
    }
} END {
    for (p in count) {
        print count[p], p
    }
}' | sort -nr | awk -v threshold="$FILE_COUNT_THRESHOLD" '$1 > threshold'
