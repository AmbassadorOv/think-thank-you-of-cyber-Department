#!/usr/bin/env bash
#
# Print directories with the number of files underneath them.
#
# A directory with a lot of files could indicates a 3rd party component.
# These are usually good candidates for purging to make Git repositories
# smaller (see `git-purge-files`).
#
# The script must be called from the root of the Git repository.
#
# Usage:
# git-find-dirs-many-files [file count threshold]
#
# Author: Lars Schneider, https://github.com/larsxschneider
#

if [ -z "$1" ]; then
    FILE_COUNT=100
else
    FILE_COUNT=$1
fi

# Optimized using a single-pass find and awk pipeline.
# This approach is O(N) where N is the total number of files,
# significantly faster than the original O(D*N) implementation.
# It also correctly excludes the .git directory.
find . -name .git -prune -o -type f -print | awk -F/ -v threshold="$FILE_COUNT" '
{
    # find . -type f outputs paths starting with "./"
    p = $1
    for (i=2; i<NF; i++) {
        p = p "/" $i
        count[p]++
    }
    count["."]++
}
END {
    for (p in count) {
        if (count[p] > threshold) {
            print count[p], p
        }
    }
}' | sort -nr
